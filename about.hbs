<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Smart TV Toolkit: third-party licenses</title>
<style>
  body { font: 15px/1.5 system-ui, sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; color: #222; }
  h1 { font-size: 1.5rem; } h2 { font-size: 1.15rem; margin-top: 2.5rem; }
  ul.crates { columns: 2; padding-left: 1.2rem; }
  pre { white-space: pre-wrap; background: #f5f5f5; padding: 1rem; border-radius: 6px; font-size: 13px; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Smart TV Toolkit is licensed under the GNU Affero General Public License v3.0. It includes the
open-source components below, each used under the license shown.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul class="crates">
{{#each used_by}}
  <li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
